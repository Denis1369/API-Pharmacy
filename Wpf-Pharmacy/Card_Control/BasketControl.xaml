<UserControl x:Class="Wpf_Pharmacy.Card_Control.BasketControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Wpf_Pharmacy.Card_Control"
             mc:Ignorable="d"
             d:DesignHeight="100" d:DesignWidth="500">
    <Border Background="White" Padding="12" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Изображение товара -->
            <Image Grid.Column="0" 
                   Source="{Binding ItemImg}" 
                   Width="75" Height="75" 
                   Margin="0,0,12,0" 
                   VerticalAlignment="Top" />

            <!-- Основной контент: название и описание -->
            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <TextBlock Text="{Binding ItemTitle}" 
                           FontWeight="Bold" FontSize="16" 
                           TextWrapping="Wrap"/>

                <TextBlock Text="{Binding ItemDesc}"
                           Foreground="#666"
                           FontSize="12"
                           TextWrapping="NoWrap"
                           TextTrimming="WordEllipsis"
                           MaxHeight="50"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" 
                        VerticalAlignment="Top" 
                        HorizontalAlignment="Right">
                <TextBlock Text="{Binding BasketItemCount, StringFormat={}Кол-во: {0}}"
                           FontSize="14"
                           HorizontalAlignment="Right"
                           Margin="0,0,0,4"/>

                <TextBlock Text="{Binding TotalPrice, StringFormat={}{0:N0} ₽}"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Right"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Grid.Column="4">
                <Button Grid.Column="4" Width="100" Height="30" x:Name="DelButton" Cursor="Hand"
        Content="Удалить" Margin="20,0" Click="DelButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="18"
                                    Padding="15,5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Grid.Column="4" Width="30" Height="30" x:Name="MinButton" Cursor="Hand"
        Content="-" Margin="20,0" Click="MinButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                CornerRadius="18"
                                Padding="10,5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Grid.Column="4" Width="30" Height="30" x:Name="AddButton" Cursor="Hand"
        Content="+" Margin="20,0" Click="AddButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                CornerRadius="18"
                Padding="10,5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>