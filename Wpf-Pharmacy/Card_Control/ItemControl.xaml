<UserControl x:Class="Wpf_Pharmacy.Card_Control.ItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="100" d:DesignWidth="500">
    <Border Background="White" Padding="12" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <Image Grid.Column="0" Source="{Binding ItemImg}" Width="75" Height="75" Margin="15,0,0,0" VerticalAlignment="Top" />

            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <TextBlock Text="{Binding ItemTitle}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap"/>

                <TextBlock x:Name="DescriptionTextBlock"
                           Text="{Binding ItemDesc}"
                           Foreground="#666"
                           FontSize="12"
                           TextWrapping="NoWrap"
                           TextTrimming="WordEllipsis"
                           MaxHeight="50"
                           Tag="Collapsed"
                           Margin="0,4,0,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="{Binding ItemStatusText}" Foreground="#00A050" FontSize="12" FontWeight="SemiBold" Margin="0,0,12,0"/>
                    <Button x:Name="InstructionButton"
                            Content="Инструкция"
                            Foreground="#00A050"
                            Background="Transparent"
                            BorderBrush="#00A050"
                            BorderThickness="1"
                            Padding="6,2"
                            Cursor="Hand"
                            FontSize="12"
                            HorizontalAlignment="Left"
                            Click="InstructionButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="12"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right">
                <TextBlock Text="{Binding ItemPrice, StringFormat={}{0:N0} ₽}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right"/>
                <Button x:Name="AddToCartButton"
                        Click="AddToCartButton_Click"
                        Content="🛒 В корзину"
                        Background="#00C8B8"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Margin="0,8,0,0"
                        Cursor="Hand"
                        Padding="16,8">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="20"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>