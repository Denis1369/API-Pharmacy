<Window x:Class="Wpf_Pharmacy.View.BasketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf_Pharmacy.View"
        mc:Ignorable="d"
        Title="Корзина" Height="700" Width="1000" MinHeight="600" MinWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Border Background="#00C8B8" Padding="10,5" DockPanel.Dock="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="103." FontSize="18" FontWeight="Bold" Foreground="White"/>

                    <Button Content="На главную" VerticalAlignment="Center" 
                        Foreground="White" Margin="30,0,0,0" Cursor="Hand"
                        x:Name="BackButton" Click="BackButton_Click"
                        Background="#00DDDDDD" BorderBrush="#00707070">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                    CornerRadius="18"
                                    Padding="10,5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>


                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Купить" VerticalAlignment="Center" Cursor="Hand"
                        x:Name="BuyButton" Click="BuyButton_Click"
                        Foreground="White" Margin="0,0,20,0" 
                        Background="#00DDDDDD" BorderBrush="#00707070">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                    CornerRadius="18"
                                    Padding="10,5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                        
                </StackPanel>

            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ItemsContainer" Orientation="Vertical" />
        </ScrollViewer>
    </Grid>
</Window>
