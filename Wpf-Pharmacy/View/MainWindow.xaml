<Window x:Class="Wpf_Pharmacy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Фармация" Height="700" Width="1000" MinHeight="400" MinWidth="500">

    <Grid>
        <DockPanel LastChildFill="True">
            <Border Background="#00C8B8" Padding="10,5" DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Логотип -->
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Margin="0,0,20,0">
                        <TextBlock Text="103." FontSize="18" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="20,0,40,0">
                        <TextBlock Text="Поиск лекарств" VerticalAlignment="Center" Foreground="White" Margin="0,0,20,0" Cursor="Hand"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="40,0,0,0">
                        <Button x:Name="CartButton" 
                                Content="🛒" 
                                ToolTip="Корзина" 
                                Background="Transparent" 
                                Foreground="White" 
                                FontSize="18" 
                                Padding="10,5"
                                Cursor="Hand"
                                Click="CartButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="18"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Content="👤 Войти" 
                                Background="Transparent" 
                                Foreground="White" 
                                Margin="15,0,0,0"
                                Cursor="Hand"
                                x:Name="LoginButton"
                                Click="LoginButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="18"
                                            Padding="10,5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Content="👤 Профиль" 
                            Background="Transparent" 
                            Foreground="White" 
                            Margin="15,0,0,0"
                            Cursor="Hand"
                            x:Name="ProfileButton"
                            Click="ProfileButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                        CornerRadius="18"
                                        Padding="10,5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Content="Выйти" 
                            Background="Transparent" 
                            Foreground="White" 
                            Margin="15,0,0,0"
                            Cursor="Hand"
                            x:Name="BackButton"
                            Click="BackButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                CornerRadius="18"
                Padding="10,5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="#F5F5F5" Padding="10" DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Label Content="Бренд:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox x:Name="BrandFilterComboBox"
                  Width="150"
                  Margin="0,0,20,0"
                  SelectionChanged="FilterChanged"/>

                    <Label Content="Цена от:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="MinPriceTextBox"
                 Width="80"
                 Margin="0,0,10,0"
                 TextChanged="FilterChanged"/>

                    <Label Content="до:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="MaxPriceTextBox"
                 Width="80"
                 Margin="0,0,20,0"
                 TextChanged="FilterChanged"/>

                    <Button Content="Сбросить" 
                Background="#FF6B6B" 
                Foreground="White"
                Padding="10,5"
                Click="ResetFilters_Click"/>
                </StackPanel>
            </Border>

            <Grid Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ItemsContainer" Orientation="Vertical" />
                </ScrollViewer>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
                    <Button x:Name="PrevPageButton" Content="◀ Пред" Width="80" Click="PrevPageButton_Click" Margin="5,0"/>
                    <TextBlock x:Name="PageInfoTextBlock" VerticalAlignment="Center" Margin="10,0" />
                    <Button x:Name="NextPageButton" Content="След ▶" Width="80" Click="NextPageButton_Click" Margin="5,0"/>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
