<Window x:Class="Wpf_Pharmacy.View.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ext="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Регистрация" Height="500" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" >

    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Создание аккаунта" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <!-- Имя -->
            <ext:WatermarkTextBox Watermark="Имя"
                                  x:Name="FirstNameTextBox"
                                  Width="300"
                                  Height="36"
                                  Margin="0,0,0,10"
                                  Padding="10"
                                  VerticalContentAlignment="Center"
                                  Background="White"
                                  BorderBrush="#CCCCCC"/>

            <!-- Фамилия -->
            <ext:WatermarkTextBox Watermark="Фамилия"
                                  x:Name="LastNameTextBox"
                                  Width="300"
                                  Height="36"
                                  Margin="0,0,0,10"
                                  Padding="10"
                                  VerticalContentAlignment="Center"
                                  Background="White"
                                  BorderBrush="#CCCCCC"/>

            <!-- Email -->
            <ext:WatermarkTextBox Watermark="Электронная почта"
                                  x:Name="EmailTextBox"
                                  Width="300"
                                  Height="36"
                                  Margin="0,0,0,10"
                                  Padding="10"
                                  VerticalContentAlignment="Center"
                                  Background="White"
                                  BorderBrush="#CCCCCC"/>

            <!-- Пароль -->
            <ext:WatermarkPasswordBox Watermark="Пароль"
                                      x:Name="PasswordBox"
                                      Width="300"
                                      Height="36"
                                      Margin="0,0,0,10"
                                      Padding="10"
                                      VerticalContentAlignment="Center"
                                      Background="White"
                                      BorderBrush="#CCCCCC"/>

            <!-- Подтверждение пароля -->
            <ext:WatermarkPasswordBox Watermark="Подтвердите пароль"
                                      x:Name="ConfirmPasswordBox"
                                      Width="300"
                                      Height="36"
                                      Margin="0,0,0,20"
                                      Padding="10"
                                      VerticalContentAlignment="Center"
                                      Background="White"
                                      BorderBrush="#CCCCCC"/>

            <!-- Кнопка Зарегистрироваться -->
            <Button Content="Зарегистрироваться"
                    Background="#00C8B8"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Width="300"
                    Height="36"
                    Cursor="Hand"
                    Click="RegisterButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="18"
                                Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Кнопка "Войти" -->
            <Button x:Name="LoginLinkButton"
        Content="Уже есть аккаунт? Войти"
        Background="Transparent"
        Foreground="#00A050"
        FontSize="12"
        Cursor="Hand"
        HorizontalAlignment="Center"
        Margin="0,10,0,0"
        Click="LoginLinkButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>